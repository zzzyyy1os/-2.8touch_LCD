<!--
 @title WiFi provisioning (QR)
 @brief Scan-to-setup screen: QR code + Chinese hint + reset button.

 320x240 landscape: QR left, hint/url/reset right column.
 The qrcode data is a placeholder here; the app replaces it at runtime
 (see wifi_provision_ui_lvgl.c -> lv_obj_find_by_name "qrcode").
 Regenerate *_gen.c from this file in LVGL Pro editor after layout edits;
 keep widget names (qrcode / hint / url / btn_reset) stable.
 Note: hint/url use the custom subset font lv_font_cn_20 (Source Han Sans
 subset, see lv_font_cn_20.c/h) applied in *_gen.c.
-->
<screen>
	<view flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center"
		style_flex_track_place="center" style_pad_column="8" style_pad_all="6" style_bg_color="0xffffff">
		<lv_qrcode name="qrcode" size="160" dark_color="0x111827" light_color="0xffffff"
			data="WIFI:S:ESP32-Setup;T:WPA;P:12345678;;" quiet_zone="true"
			style_border_color="0x111827" style_border_width="3" />
		<lv_obj width="content" height="content" flex_flow="column"
			style_flex_main_place="center" style_flex_cross_place="center"
			style_pad_row="8" style_bg_opa="transparent" style_border_width="0" style_pad_all="0">
			<lv_label name="hint" text="WIFI链接网站" style_text_color="0x111827" />
			<lv_label name="url" text="192.168.4.1" style_text_color="0x111827" />
			<lv_button name="btn_reset" width="110" height="34">
				<lv_label name="btn_reset_label" align="center" text="Reset WiFi" />
			</lv_button>
		</lv_obj>
	</view>
</screen>
